#!/usr/bin/env bash
# pi-orb setup hook: what `make` (VM and image) needs on Debian bookworm x86-64.
set -euo pipefail

if command -v sudo >/dev/null 2>&1 && [ "$(id -u)" != 0 ]; then SUDO=sudo; else SUDO=; fi

# shaderc (GLSL -> SPIR-V for SDL_GPU on Vulkan); OpenSSL 3 (TLS); libwayland-client (desktop windows); cmake and ninja build SDL3
PKGS="libshaderc-dev libssl-dev libwayland-dev cmake ninja-build libvulkan-dev spirv-tools pkg-config git"
# the UEFI VM (make uefi, docs/uefi.md): a freestanding cross compiler and linker, QEMU and its UEFI firmware, for
# this machine's CPU (make uefi's default UEFI_ARCH)
case "$(uname -m)" in
    aarch64|arm64) PKGS="$PKGS clang lld qemu-system-arm qemu-efi-aarch64" ;;
    *) PKGS="$PKGS clang lld qemu-system-x86 ovmf" ;;
esac
# what CI's container installs before this hook: compilers, X11 for SDL3 (before it is built), Xvfb and
# software Vulkan for the UI tests (.agents/resume starts the display), Node for tools/samaltak-ctl
PKGS="$PKGS ca-certificates build-essential python3 perl less xvfb xauth mesa-vulkan-drivers
    libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev"
if ! dpkg -s $PKGS >/dev/null 2>&1; then
    $SUDO apt-get update
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $PKGS
fi
command -v node >/dev/null 2>&1 || $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs

# bookworm has no SDL3: build once into $HOME (persists), install to /usr/local on every incarnation
SDL=$HOME/src/SDL
SDL_CONFIG=$SDL/build/include-config-release/build_config/SDL_build_config.h
if [ -f "$SDL/build/libSDL3.so" ] && ! grep -q '^#define SDL_VIDEO_DRIVER_X11 1' "$SDL_CONFIG" 2>/dev/null; then
    rm -rf "$SDL/build"   # built before the X11 headers were installed: no window outside a console
fi
if [ ! -f "$SDL/build/libSDL3.so" ]; then
    [ -d "$SDL/.git" ] || git clone --depth 1 --branch release-3.2.24 https://github.com/libsdl-org/SDL.git "$SDL"
    cmake -S "$SDL" -B "$SDL/build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_UNIX_CONSOLE_BUILD=ON
    cmake --build "$SDL/build"
fi
if [ ! -f /usr/local/lib/pkgconfig/sdl3.pc ] || [ ! -e /usr/local/lib/libSDL3.so.0 ] \
    || ! grep -q libX11.so.6 /usr/local/lib/libSDL3.so.0; then
    $SUDO cmake --install "$SDL/build"
    $SUDO ldconfig
fi

# bookworm's libshaderc.so leaves glslang/SPIRV-Tools symbols undefined and its shaderc.pc
# says only -lshaderc: shadow it in /usr/local (searched first) with the full link line.
PC=/usr/local/lib/pkgconfig/shaderc.pc
WANT='Name: shaderc
Description: shaderc with its static glslang and SPIRV-Tools dependencies (bookworm)
Version: 2023.2.1
Libs: -lshaderc_combined -Wl,--start-group -lglslang -lSPIRV -lMachineIndependent -lGenericCodeGen -lOSDependent -lOGLCompiler -lglslang-default-resource-limits -lSPIRV-Tools-opt -lSPIRV-Tools -Wl,--end-group -lstdc++ -lpthread -lm
Cflags:'
if [ "$(cat "$PC" 2>/dev/null)" != "$WANT" ]; then
    $SUDO mkdir -p "${PC%/*}"
    printf '%s\n' "$WANT" | $SUDO tee "$PC" >/dev/null
fi
